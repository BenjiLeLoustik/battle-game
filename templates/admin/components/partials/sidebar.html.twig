{% set sections = admin_sections() %}

<nav class="admin-sidebar" aria-label="{{ 'admin.nav.label'|trans({}, 'admin') }}">
    {% for group in groups|filter(group => group.items|filter(item => sections[item.id] is defined)|length > 0) %}
        <div class="admin-sidebar__group">
            <span class="admin-sidebar__title">
                {{ ('admin.nav.' ~ group.id)|trans({}, 'admin') }}
            </span>
            {% for item in group.items|filter(item => sections[item.id] is defined) %}
                <a href="{{ path(sections[item.id][0]) }}" class="admin-sidebar__link{{ item.id == active ? ' admin-sidebar__link--active' }}"{% if item.id == active %} aria-current="page"{% endif %}>
                    <svg class="admin-sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ item.icon }}"/></svg>
                    <span class="admin-sidebar__label">
                        {{ ('admin.nav.' ~ item.id)|trans({}, 'admin') }}
                    </span>
                </a>
            {% endfor %}
        </div>
    {% endfor %}
    <div class="admin-sidebar__group">
        <span class="admin-sidebar__title">
            {{ 'admin.nav.help'|trans({}, 'admin') }}
        </span>
        <a href="{{ path('admin_twofa_index') }}" class="admin-sidebar__link{{ active == 'security' ? ' admin-sidebar__link--active' }}"{% if active == 'security' %} aria-current="page"{% endif %}>
            <svg class="admin-sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3zM9 12l2 2 4-4"/></svg>
            <span class="admin-sidebar__label">
                {{ 'admin.nav.security'|trans({}, 'admin') }}
            </span>
        </a>
        <a href="{{ path('admin_docs_index') }}" class="admin-sidebar__link{{ active == 'docs' ? ' admin-sidebar__link--active' }}"{% if active == 'docs' %} aria-current="page"{% endif %}>
            <svg class="admin-sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7M8 11h5"/></svg>
            <span class="admin-sidebar__label">
                {{ 'admin.nav.docs'|trans({}, 'admin') }}
            </span>
        </a>
    </div>
    <div class="admin-sidebar__footer">
        <span class="admin-sidebar__brand"><span class="admin-sidebar__dot" aria-hidden="true"></span>BattleGame</span>
        <span class="admin-sidebar__chip" title="{{ 'admin.version.platform'|trans({}, 'admin') }}">v{{ constant('App\\Kernel::VERSION') }}</span>
        <span class="admin-sidebar__chip" title="{{ 'admin.version.sdk'|trans({}, 'admin') }}">SDK {{ constant('App\\Sdk\\AbstractSdk::VERSION') }}</span>
    </div>
</nav>