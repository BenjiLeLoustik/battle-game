{% extends '@admin/layouts/default.html.twig' %}

{% import '@admin/components/macros/ui.html.twig' as admin_ui %}

{% set active = 'channels' %}

{% block title %}{{ 'admin.channels.title'|trans({}, 'admin') }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="admin-page">
        <div class="admin-page__head">
            <div class="admin-page__intro">
                <h1 class="admin-page__title">{{ 'admin.channels.title'|trans({}, 'admin') }}</h1>
                <span class="admin-page__subtitle">{{ 'admin.channels.subtitle'|trans({}, 'admin') }}</span>
            </div>
            <a href="{{ path('admin_channel_new') }}" class="admin-btn admin-btn--primary">+ {{ 'admin.channels.new'|trans({}, 'admin') }}</a>
        </div>

        <section class="admin-panel admin-panel--flush">
            {% if channels is empty %}
                <p class="admin-empty">{{ 'admin.channels.empty'|trans({}, 'admin') }}</p>
            {% else %}
                {% set pager = paginate(channels) %}
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead><tr>{% for column in ['channel', 'read', 'write', 'messages', 'status', 'actions'] %}<th class="admin-table__th">{{ ('admin.channels.column.' ~ column)|trans({}, 'admin') }}</th>{% endfor %}</tr></thead>
                        <tbody>
                            {% for row in pager.items %}
                                {% set channel = row.channel %}
                                <tr class="admin-table__row">
                                    <td class="admin-table__cell">
                                        <span class="admin-user__text">
                                            <span class="admin-user__name"># {{ channel.name }}</span>
                                            <span class="admin-user__meta">{{ channel.description ?: '/chat/' ~ channel.slug }}</span>
                                        </span>
                                    </td>
                                    <td class="admin-table__cell">{{ channel.readAccess.translate() }}</td>
                                    <td class="admin-table__cell">
                                        {{ channel.writeAccess.translate() }}
                                        {% if channel.cooldown > 1 %}<span class="admin-pill">{{ 'admin.channels.slow'|trans({ seconds: channel.cooldown }, 'admin') }}</span>{% endif %}
                                    </td>
                                    <td class="admin-table__cell">{{ row.messages }}</td>
                                    <td class="admin-table__cell">{{ admin_ui.post('admin_channel_toggle', { id: channel.id }, ('admin.channels.states.' ~ (channel.active ? 'active' : 'inactive'))|trans({}, 'admin'), 'admin-pill' ~ (channel.active ? ' admin-pill--ok' : ''), 'admin-channels') }}</td>
                                    <td class="admin-table__cell">
                                        <span class="admin-actions admin-actions--nowrap">
                                            <a href="{{ path('admin_channel_edit', { id: channel.id }) }}" class="admin-btn admin-btn--secondary admin-btn--small">{{ 'admin.edit'|trans({}, 'admin') }}</a>
                                            {% if channel.active %}
                                                <a href="{{ path('site_chat_channel', { channel: channel.slug }) }}" class="admin-btn admin-btn--ghost admin-btn--small" target="_blank" rel="noopener">{{ 'admin.view'|trans({}, 'admin') }}</a>
                                            {% endif %}
                                            {% if row.messages %}
                                                {{ admin_ui.post('admin_channel_purge', { id: channel.id }, 'admin.channels.purge'|trans({}, 'admin'), 'admin-btn admin-btn--ghost admin-btn--small', 'admin-channels', 'admin.channels.purge_confirm'|trans({ name: channel.name, count: row.messages }, 'admin')) }}
                                            {% endif %}
                                            {{ admin_ui.post('admin_channel_delete', { id: channel.id }, 'admin.delete'|trans({}, 'admin'), 'admin-btn admin-btn--danger admin-btn--small', 'admin-channels', 'admin.channels.delete_confirm'|trans({ name: channel.name }, 'admin')) }}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {{ admin_ui.pagination(pager) }}
            {% endif %}
        </section>
        <p class="admin-note"><span class="admin-note__icon" aria-hidden="true">i</span>{{ 'admin.channels.note'|trans({}, 'admin') }}</p>
    </div>
{% endblock %}
