{% extends '@admin/layouts/default.html.twig' %}

{% import '@admin/components/macros/ui.html.twig' as admin_ui %}

{% set active = 'emails' %}
{% set title = list.id ? list.name : 'admin.emails.lists.new'|trans({}, 'admin') %}

{% block title %}{{ title }} · {{ parent() }}{% endblock %}

{% block content %}
    <form class="admin-page admin-page--narrow" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('admin-emails') }}">
        <nav class="admin-crumbs" aria-label="{{ 'admin.breadcrumb'|trans({}, 'admin') }}">
            <a href="{{ path('admin_email_lists') }}" class="admin-crumbs__link">{{ 'admin.emails.tabs.lists'|trans({}, 'admin') }}</a>
            <span aria-hidden="true">/</span>
            <span class="admin-crumbs__current">{{ title }}</span>
        </nav>
        <div class="admin-page__head">
            <h1 class="admin-page__title">{{ title }}</h1>
            {% if count is not null %}
                <span class="admin-pill admin-pill--accent">{{ 'admin.emails.lists.recipients'|trans({ count: count }, 'admin') }}</span>
            {% endif %}
        </div>

        <section class="admin-panel">
            <div class="admin-form-grid">
                <label class="admin-field">
                    {{ 'admin.emails.lists.name'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="name" value="{{ list.name }}" maxlength="80" required>
                    {{ admin_ui.error(errors, 'name') }}
                </label>
                <label class="admin-field">
                    {{ 'admin.emails.lists.description'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="description" value="{{ list.description }}" maxlength="160">
                </label>
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__intro">
                <h2 class="admin-panel__title">{{ 'admin.emails.lists.audience'|trans({}, 'admin') }}</h2>
                <span class="admin-panel__help">{{ 'admin.emails.lists.audience_help'|trans({}, 'admin') }}</span>
            </div>
            <label class="admin-field">
                {{ 'admin.emails.lists.audience_field'|trans({}, 'admin') }}
                <select class="admin-field__input" name="audience">
                    {% for audience in audiences %}
                        <option value="{{ audience.value }}"{{ list.audience == audience ? ' selected' }}>{{ audience.translate() }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="admin-field" data-component="FieldReveal" data-field="audience" data-values="country"{{ list.audience.value != 'country' ? ' hidden' }}>
                {{ 'admin.emails.lists.country'|trans({}, 'admin') }}
                <select class="admin-field__input" name="country">
                    {% for country in countries %}
                        <option value="{{ country.code }}"{{ list.country == country.code ? ' selected' }}>{{ country|localize('name') }} ({{ country.code }})</option>
                    {% endfor %}
                </select>
                {{ admin_ui.error(errors, 'country') }}
            </label>
            <label class="admin-field" data-component="FieldReveal" data-field="audience" data-values="game"{{ list.audience.value != 'game' ? ' hidden' }}>
                {{ 'admin.emails.lists.game'|trans({}, 'admin') }}
                <select class="admin-field__input" name="game">
                    {% for game in games %}
                        <option value="{{ game.id }}"{{ list.game and list.game.id == game.id ? ' selected' }}>{{ game.name }}</option>
                    {% endfor %}
                </select>
                {{ admin_ui.error(errors, 'game') }}
            </label>
            <label class="admin-check">
                <input type="checkbox" class="admin-check__input" name="opt_in"{{ list.optIn ? ' checked' }}>
                <span class="mailing-option">
                    <strong>{{ 'admin.emails.lists.opt_in'|trans({}, 'admin') }}</strong>
                    <span class="admin-panel__help">{{ 'admin.emails.lists.opt_in_help'|trans({}, 'admin') }}</span>
                </span>
            </label>
        </section>

        <div class="admin-actions admin-actions--end">
            <a href="{{ path('admin_email_lists') }}" class="admin-btn admin-btn--ghost">{{ 'admin.cancel'|trans({}, 'admin') }}</a>
            <button type="submit" class="admin-btn admin-btn--primary">{{ 'admin.save'|trans({}, 'admin') }}</button>
        </div>
    </form>
{% endblock %}
