{% extends '@admin/layouts/default.html.twig' %}

{% import '@admin/components/macros/ui.html.twig' as admin_ui %}
{% import '@site/components/macros/user.html.twig' as ui %}

{% set active = 'studio' %}
{% set title = task.id ? task.title : 'admin.tasks.new'|trans({}, 'admin') %}
{% set back = path('admin_studio_show', { slug: game.slug }) ~ '#studio-tasks' %}

{% block title %}{{ title }} · {{ parent() }}{% endblock %}

{% block content %}
    <form class="admin-page admin-page--narrow" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('studio-' ~ game.slug) }}">
        <nav class="admin-crumbs" aria-label="{{ 'admin.breadcrumb'|trans({}, 'admin') }}">
            <a href="{{ path('admin_studio_index') }}" class="admin-crumbs__link">{{ 'admin.studio.title'|trans({}, 'admin') }}</a>
            <span aria-hidden="true">/</span>
            <a href="{{ back }}" class="admin-crumbs__link">{{ game.name }}</a>
            <span aria-hidden="true">/</span>
            <span class="admin-crumbs__current">{{ title }}</span>
        </nav>
        <div class="admin-page__head">
            <h1 class="admin-page__title">{{ title }}</h1>
        </div>

        <section class="admin-panel">
            <label class="admin-field">
                {{ 'admin.tasks.fields.title'|trans({}, 'admin') }}
                <input class="admin-field__input" name="title" value="{{ task.title }}" maxlength="120" required>
                {{ admin_ui.error(errors, 'title') }}
            </label>
            <div class="admin-form-grid">
                <label class="admin-field">
                    {{ 'admin.tasks.status'|trans({}, 'admin') }}
                    <select class="admin-field__input" name="status">
                        {% for status in statuses %}
                            <option value="{{ status.value }}"{{ status == task.status ? ' selected' }}>{{ status.translate() }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="admin-field">
                    {{ 'admin.tasks.fields.start_at'|trans({}, 'admin') }}
                    <input class="admin-field__input" type="date" name="start_at" value="{{ task.startAt ? task.startAt|date('Y-m-d') }}">
                </label>
                <label class="admin-field">
                    {{ 'admin.tasks.fields.end_at'|trans({}, 'admin') }}
                    <input class="admin-field__input" type="date" name="end_at" value="{{ task.endAt ? task.endAt|date('Y-m-d') }}">
                    {{ admin_ui.error(errors, 'end_at') }}
                </label>
            </div>
            <label class="admin-field">
                {{ 'admin.tasks.fields.description'|trans({}, 'admin') }}
                <textarea class="admin-field__input admin-field__input--area" name="description" rows="4">{{ task.description }}</textarea>
            </label>
            <label class="admin-field">
                {{ 'admin.tasks.fields.checklist'|trans({}, 'admin') }}
                <textarea class="admin-field__input admin-field__input--area" name="checklist" rows="5" placeholder="{{ 'admin.tasks.fields.checklist_placeholder'|trans({}, 'admin') }}">{{ task.checklistText }}</textarea>
                <span class="admin-panel__help">{{ 'admin.tasks.fields.checklist_help'|trans({}, 'admin') }}</span>
            </label>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__intro">
                <h2 class="admin-panel__title">{{ 'admin.tasks.fields.assignees'|trans({}, 'admin') }}</h2>
                <span class="admin-panel__help">{{ 'admin.tasks.fields.assignees_help'|trans({}, 'admin') }}</span>
            </div>
            <div class="studio-task-form__people">
                {% for admin in admins %}
                    <label class="admin-check studio-task-form__person">
                        <input type="checkbox" class="admin-check__input" name="assignees[]" value="{{ admin.id }}"{{ task.assigned(admin) ? ' checked' }}>
                        {{ ui.avatar(admin, 'round') }}
                        <span>{{ admin.username }}</span>
                    </label>
                {% endfor %}
            </div>
        </section>

        <div class="admin-actions admin-actions--end">
            <a href="{{ back }}" class="admin-btn admin-btn--ghost">{{ 'admin.cancel'|trans({}, 'admin') }}</a>
            <button type="submit" class="admin-btn admin-btn--primary">{{ 'admin.save'|trans({}, 'admin') }}</button>
        </div>
    </form>
{% endblock %}
