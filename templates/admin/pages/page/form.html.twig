{% extends '@admin/layouts/default.html.twig' %}

{% import '@admin/components/macros/ui.html.twig' as admin_ui %}

{% set active = 'pages' %}
{% set title = page.id ? page.title : 'admin.pages.new'|trans({}, 'admin') %}

{% block title %}{{ title }} · {{ parent() }}{% endblock %}

{% block content %}
    <form class="admin-page admin-page--narrow" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('admin-pages') }}">
        <nav class="admin-crumbs" aria-label="{{ 'admin.breadcrumb'|trans({}, 'admin') }}">
            <a href="{{ path('admin_page_index') }}" class="admin-crumbs__link">{{ 'admin.pages.title'|trans({}, 'admin') }}</a>
            <span aria-hidden="true">/</span>
            <span class="admin-crumbs__current">{{ title }}</span>
        </nav>
        <h1 class="admin-page__title">{{ title }}</h1>

        <section class="admin-panel">
            <h2 class="admin-panel__title">{{ 'admin.pages.info'|trans({}, 'admin') }}</h2>
            <div class="admin-form-grid">
                <label class="admin-field">
                    {{ 'admin.pages.page_title'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="title" value="{{ page.title }}" maxlength="120" required>
                    {{ admin_ui.error(errors, 'title') }}
                </label>
                <label class="admin-field">
                    {{ 'admin.pages.path'|trans({}, 'admin') }}
                    <span class="page-path">
                        <span class="page-path__prefix">/</span>
                        <input class="admin-field__input page-path__input" name="path" value="{{ page.path }}" maxlength="180" placeholder="faq">
                    </span>
                    <span class="admin-panel__help">{{ 'admin.pages.path_help'|trans({}, 'admin') }}</span>
                    {{ admin_ui.error(errors, 'path') }}
                </label>
                <label class="admin-field admin-field--wide">
                    {{ 'admin.pages.description'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="description" value="{{ page.description }}" maxlength="160">
                </label>
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__intro">
                <h2 class="admin-panel__title">{{ 'admin.pages.content'|trans({}, 'admin') }}</h2>
                <span class="admin-panel__help">{{ 'admin.pages.content_help'|trans({}, 'admin') }}</span>
            </div>
            <nav class="admin-segment">
                {% for format in formats %}
                    <label class="admin-segment__item{{ page.format == format ? ' admin-segment__item--active' }}">
                        <input type="radio" class="sr-only" name="format" value="{{ format.value }}"{{ page.format == format ? ' checked' }}>
                        {{ format.translate() }}
                    </label>
                {% endfor %}
            </nav>
            <label class="admin-field">
                {{ 'admin.pages.body'|trans({}, 'admin') }}
                <textarea class="admin-field__input admin-field__input--area admin-field__input--code" name="content" rows="18" spellcheck="false" placeholder="## {faq_titre}&#10;&#10;{faq_intro}">{{ page.content }}</textarea>
            </label>
            <label class="admin-field" data-component="FieldReveal" data-field="format" data-values="html"{{ page.format.value != 'html' ? ' hidden' }}>
                {{ 'admin.pages.style'|trans({}, 'admin') }}
                <textarea class="admin-field__input admin-field__input--area admin-field__input--code" name="style" rows="8" spellcheck="false" placeholder="h2 { color: #2EE6D6; }">{{ page.style }}</textarea>
                <span class="admin-panel__help">{{ 'admin.pages.style_help'|trans({}, 'admin') }}</span>
            </label>
        </section>

        <section class="admin-panel admin-panel--flush" data-component="PageStrings" data-locales="{{ locales|json_encode }}">
            <div class="admin-panel__bar">
                <div class="admin-panel__intro">
                    <h2 class="admin-panel__title">{{ 'admin.pages.strings.title'|trans({}, 'admin') }}</h2>
                    <span class="admin-panel__help">{{ 'admin.pages.strings.help'|trans({}, 'admin') }}</span>
                </div>
            </div>
            <p class="admin-empty" data-empty{{ strings is not empty ? ' hidden' }}>{{ 'admin.pages.strings.empty'|trans({}, 'admin') }}</p>
            <div class="admin-table-wrap">
                <table class="admin-table page-strings"{{ strings is empty ? ' hidden' }}>
                    <thead>
                        <tr>
                            <th class="admin-table__th">{{ 'admin.pages.strings.key'|trans({}, 'admin') }}</th>
                            {% for locale in locales %}
                                <th class="admin-table__th">{{ locale|upper }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody data-rows>
                        {% for key, values in strings %}
                            <tr class="admin-table__row" data-key="{{ key }}">
                                <td class="admin-table__cell admin-table__cell--mono page-strings__key">{{ '{' ~ key ~ '}' }}</td>
                                {% for locale in locales %}
                                    <td class="admin-table__cell">
                                        <textarea class="admin-field__input page-strings__input" name="strings[{{ key }}][{{ locale }}]" rows="1" aria-label="{{ key }} · {{ locale|upper }}">{{ values[locale] ?? '' }}</textarea>
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__intro">
                <h2 class="admin-panel__title">{{ 'admin.pages.publication'|trans({}, 'admin') }}</h2>
                <span class="admin-panel__help">{{ 'admin.pages.publication_help'|trans({}, 'admin') }}</span>
            </div>
            <div class="admin-form-grid">
                <label class="admin-field">
                    {{ 'admin.pages.footer'|trans({}, 'admin') }}
                    <select class="admin-field__input" name="footer">
                        {% for footer in footers %}
                            <option value="{{ footer.value }}"{{ page.footer == footer ? ' selected' }}>{{ footer.translate() }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="admin-field">
                    {{ 'admin.pages.position'|trans({}, 'admin') }}
                    <input class="admin-field__input" type="number" name="position" value="{{ page.position }}" min="0" max="99">
                </label>
            </div>
            <label class="admin-check">
                <input type="checkbox" class="admin-check__input" name="published"{{ page.published ? ' checked' }}>
                {{ 'admin.pages.published'|trans({}, 'admin') }}
            </label>
        </section>

        {{ admin_ui.translations(page) }}

        <div class="admin-actions admin-actions--end">
            <a href="{{ path('admin_page_index') }}" class="admin-btn admin-btn--ghost">{{ 'admin.cancel'|trans({}, 'admin') }}</a>
            <button type="submit" class="admin-btn admin-btn--primary">{{ (page.id ? 'admin.save' : 'admin.pages.create')|trans({}, 'admin') }}</button>
        </div>
    </form>
{% endblock %}
