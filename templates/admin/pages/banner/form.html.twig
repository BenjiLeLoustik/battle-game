{% extends '@admin/layouts/default.html.twig' %}

{% import '@admin/components/macros/ui.html.twig' as admin_ui %}

{% set active = 'banners' %}
{% set title = banner.id ? 'admin.banners.edit'|trans({}, 'admin') : 'admin.banners.new'|trans({}, 'admin') %}

{% block title %}{{ title }} · {{ parent() }}{% endblock %}

{% block content %}
    <form class="admin-page admin-page--narrow" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('admin-banners') }}">
        <nav class="admin-crumbs" aria-label="{{ 'admin.breadcrumb'|trans({}, 'admin') }}">
            <a href="{{ path('admin_banner_index', { list: banner.list.id }) }}" class="admin-crumbs__link">{{ 'admin.banners.title'|trans({}, 'admin') }}</a>
            <span aria-hidden="true">/</span>
            <span class="admin-crumbs__current">{{ title }}</span>
        </nav>
        <h1 class="admin-page__title">{{ title }}</h1>

        <section class="admin-panel">
            <div class="admin-panel__intro">
                <h2 class="admin-panel__title">{{ 'admin.banners.content'|trans({}, 'admin') }}</h2>
                <span class="admin-panel__help">{{ 'admin.banners.content_help'|trans({}, 'admin') }}</span>
            </div>
            <label class="admin-field">
                {{ 'admin.banners.text'|trans({}, 'admin') }}
                <input class="admin-field__input" name="text" value="{{ banner.text }}" maxlength="160" required>
                {% if error %}<span class="admin-field__error">{{ error|trans({}, 'admin') }}</span>{% endif %}
            </label>
            <div class="admin-form-grid">
                <label class="admin-field">
                    {{ 'admin.banners.cta'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="cta" value="{{ banner.cta }}" maxlength="40">
                </label>
                <label class="admin-field">
                    {{ 'admin.banners.url'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="url" value="{{ banner.url }}" maxlength="255" list="banner-links" placeholder="/leaderboard">
                    <datalist id="banner-links">
                        <option value="{{ path('site_leaderboard_index') }}">{{ 'site.nav.leaderboard'|trans }}</option>
                        <option value="{{ path('site_security_register') }}">{{ 'site.auth.register'|trans }}</option>
                        <option value="{{ path('site_room_index') }}">{{ 'site.nav.rooms'|trans }}</option>
                    </datalist>
                </label>
            </div>
            <div class="admin-choices">
                {% for type in types %}
                    <label class="admin-choice">
                        <input type="radio" class="admin-choice__input" name="type" value="{{ type.value }}"{{ banner.type == type ? ' checked' }}>
                        <span class="admin-choice__head"><span class="banner-preview__dot banner-preview__dot--{{ type.value }}"></span><strong>{{ type.translate() }}</strong></span>
                    </label>
                {% endfor %}
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__intro">
                <h2 class="admin-panel__title">{{ 'admin.banners.diffusion'|trans({}, 'admin') }}</h2>
                <span class="admin-panel__help">{{ 'admin.banners.diffusion_help'|trans({}, 'admin') }}</span>
            </div>
            <div class="admin-form-grid">
                <label class="admin-field">
                    {{ 'admin.banners.list'|trans({}, 'admin') }}
                    <select class="admin-field__input" name="list">
                        {% for list in lists %}
                            <option value="{{ list.id }}"{{ banner.list.id == list.id ? ' selected' }}>{{ list.name }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="admin-field">
                    {{ 'admin.banners.starts'|trans({}, 'admin') }}
                    <input class="admin-field__input" type="datetime-local" name="starts_at" value="{{ banner.startsAt ? banner.startsAt|date('Y-m-d\\TH:i') }}">
                </label>
                <label class="admin-field">
                    {{ 'admin.banners.ends'|trans({}, 'admin') }}
                    <input class="admin-field__input" type="datetime-local" name="ends_at" value="{{ banner.endsAt ? banner.endsAt|date('Y-m-d\\TH:i') }}">
                </label>
                <label class="admin-field">
                    {{ 'admin.banners.audience'|trans({}, 'admin') }}
                    <select class="admin-field__input" name="audience">
                        {% for audience in audiences %}
                            <option value="{{ audience.value }}"{{ banner.audience == audience ? ' selected' }}>{{ audience.translate() }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="admin-field">
                    {{ 'admin.banners.pages'|trans({}, 'admin') }}
                    <select class="admin-field__input" name="pages">
                        {% for page in pages %}
                            <option value="{{ page.value }}"{{ banner.pages == page ? ' selected' }}>{{ page.translate() }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <label class="admin-check">
                <input type="checkbox" class="admin-check__input" name="dismissible"{{ banner.dismissible ? ' checked' }}>
                {{ 'admin.banners.dismissible'|trans({}, 'admin') }}
            </label>
        </section>

        {{ admin_ui.translations(banner) }}

        <div class="admin-actions admin-actions--end">
            <a href="{{ path('admin_banner_index', { list: banner.list.id }) }}" class="admin-btn admin-btn--ghost">{{ 'admin.cancel'|trans({}, 'admin') }}</a>
            <button type="submit" name="publish" value="0" class="admin-btn admin-btn--secondary">{{ 'admin.banners.draft'|trans({}, 'admin') }}</button>
            <button type="submit" name="publish" value="1" class="admin-btn admin-btn--primary">{{ 'admin.banners.save_publish'|trans({}, 'admin') }}</button>
        </div>
    </form>
{% endblock %}
