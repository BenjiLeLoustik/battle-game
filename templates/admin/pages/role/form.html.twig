{% extends '@admin/layouts/default.html.twig' %}

{% import '@admin/components/macros/ui.html.twig' as admin_ui %}

{% import '@site/components/macros/user.html.twig' as ui %}

{% set active = 'roles' %}
{% set title = role.id ? role.name : 'admin.roles.new'|trans({}, 'admin') %}

{% block title %}{{ title }} · {{ parent() }}{% endblock %}

{% block content %}
    <form class="admin-page" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('admin-roles') }}">
        <nav class="admin-crumbs" aria-label="{{ 'admin.breadcrumb'|trans({}, 'admin') }}">
            <a href="{{ path('admin_role_index') }}" class="admin-crumbs__link">{{ 'admin.roles.title'|trans({}, 'admin') }}</a>
            <span aria-hidden="true">/</span>
            <span class="admin-crumbs__current">{{ title }}</span>
        </nav>
        <h1 class="admin-page__title">{{ title }}</h1>

        <section class="admin-panel">
            <h2 class="admin-panel__title">{{ 'admin.roles.role'|trans({}, 'admin') }}</h2>
            <div class="admin-form-grid">
                <label class="admin-field">
                    {{ 'admin.roles.name'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="name" value="{{ role.name }}" maxlength="60" required>
                    {% if error %}<span class="admin-field__error">{{ error|trans({}, 'admin') }}</span>{% endif %}
                </label>
                <div class="admin-field">
                    {{ 'admin.roles.color'|trans({}, 'admin') }}
                    {{ admin_ui.color('color', role.color, 'admin.roles.color'|trans({}, 'admin')) }}
                </div>
                <label class="admin-field admin-field--wide">
                    {{ 'admin.roles.description'|trans({}, 'admin') }}
                    <input class="admin-field__input" name="description" value="{{ role.description }}" maxlength="160">
                </label>
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__intro">
                <h2 class="admin-panel__title">{{ 'admin.roles.permissions'|trans({}, 'admin') }}</h2>
                <span class="admin-panel__help">{{ role.system ? 'admin.roles.system_help'|trans({}, 'admin') : 'admin.roles.permissions_help'|trans({}, 'admin') }}</span>
            </div>
            <div class="admin-permissions-list">
                {% for group, permissions in groups %}
                    {% set checked = role.system ? permissions|length : permissions|filter(permission => permission in role.permissions)|length %}
                    <details class="admin-permissions" data-component="CheckAll"{{ checked > 0 or loop.first ? ' open' }}>
                        <summary class="admin-permissions__summary">
                            <svg class="admin-permissions__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                            <span class="admin-permissions__title">{{ ('admin.permissions.groups.' ~ group)|trans({}, 'admin') }}</span>
                            <span class="admin-pill admin-permissions__count{{ checked == permissions|length ? ' admin-pill--ok' : (checked > 0 ? ' admin-pill--accent') }}" data-count>{{ checked }} / {{ permissions|length }}</span>
                        </summary>
                        <fieldset class="admin-permissions__body"{{ role.system ? ' disabled' }}>
                            <label class="admin-check admin-permissions__all">
                                <input type="checkbox" class="admin-check__input" data-all>
                                {{ 'admin.roles.all_group'|trans({ count: permissions|length }, 'admin') }}
                            </label>
                            <div class="admin-permissions__list">
                                {% for permission in permissions %}
                                    {% set key = permission|replace({ '.': '_' }) %}
                                    <label class="admin-check admin-permissions__item">
                                        <input type="checkbox" class="admin-check__input" name="permissions[]" value="{{ permission }}"{{ role.system or permission in role.permissions ? ' checked' }}>
                                        <span class="admin-permissions__text">
                                            <span class="admin-permissions__name">{{ ('admin.permissions.' ~ key)|trans({}, 'admin') }}</span>
                                            <span class="admin-permissions__help">{{ ('admin.permissions.help.' ~ key)|trans({}, 'admin') }}</span>
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </details>
                {% endfor %}
            </div>
        </section>

        {% if members is not empty %}
            <section class="admin-panel">
                <h2 class="admin-panel__title">{{ 'admin.roles.members'|trans({ count: members|length }, 'admin') }}</h2>
                <div class="admin-actions">
                    {% for member in members %}
                        <span class="admin-pill">{{ ui.avatar(member, 'sm') }} {{ member.username }}</span>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <div class="admin-actions admin-actions--end">
            <a href="{{ path('admin_role_index') }}" class="admin-btn admin-btn--ghost">{{ 'admin.cancel'|trans({}, 'admin') }}</a>
            <button type="submit" class="admin-btn admin-btn--primary">{{ (role.id ? 'admin.save' : 'admin.roles.create')|trans({}, 'admin') }}</button>
        </div>
    </form>
{% endblock %}
