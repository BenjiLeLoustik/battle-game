{% extends '@site/layouts/default.html.twig' %}

{% import '@site/components/macros/shop.html.twig' as shop %}

{% set active = 'shop' %}

{% block title %}
    {{ 'site.shop.subscription_gifts.title'|trans }} · {{ parent() }}
{% endblock %}

{% block content %}
    <div class="shop">
        <div class="shop__head">
            <div class="shop__intro">
                <h1 class="shop__title">
                    {{ 'site.shop.subscription_gifts.title'|trans }}
                </h1>

                <p class="shop__subtitle">
                    {{ 'site.shop.subscription_gifts.intro'|trans }}
                </p>

                {% include '@site/pages/shop/_nav.html.twig' with { page: 'subscription_gifts' } %}
            </div>
        </div>

        {{ shop.flashes() }}

        {% for package in packages %}
            {% set gift = package.gift %}
            {% set form = values[gift.id] ?? {} %}

            <section class="subscription-gifts"
                     aria-labelledby="gift-title-{{ gift.id }}">
                <div class="subscription-gifts__head">
                    <span class="subscription-gifts__mark" aria-hidden="true">
                        {{ shop.icon('gift') }}
                    </span>

                    <div class="subscription-gifts__heading">
                        <span class="subscription-gifts__eyebrow">
                            {{ 'site.shop.subscription_gifts.welcome_label'|trans }}
                        </span>

                        <h2 class="subscription-gifts__title"
                            id="gift-title-{{ gift.id }}">
                            {{ gift.offerName }}
                        </h2>
                    </div>

                    <time class="subscription-gifts__date"
                          datetime="{{ gift.createdAt|date('c') }}">
                        {{ 'site.shop.subscription_gifts.received_date'|trans({
                            date: gift.createdAt|date('d/m/Y')
                        }) }}
                    </time>
                </div>

                <ul class="subscription-gifts__list">
                    {% for item in package.items %}
                        {% set product = item.productObject %}
                        {% set kind = product and item.type == 'cosmetic' ? product.option('kind') : null %}
                        {% set state = item.delivery ? item.delivery.status.value : item.status %}
                        {% set tone = state in ['granted', 'shipped'] ? 'success' : (state in ['cancelled', 'refunded'] ? 'cancelled' : 'pending') %}

                        <li class="subscription-gifts__item">
                            <div class="subscription-gifts__preview"
                                 aria-hidden="true">
                                {% if kind in ['frame', 'banner', 'victory'] %}
                                    {{ shop.cosmetic(product, app_user().initials, 'sm') }}
                                {% elseif product and product.image %}
                                    <img class="subscription-gifts__image" src="{{ product.image }}" alt="" loading="lazy">
                                {% else %}
                                    {{ shop.icon(item.type) }}
                                {% endif %}
                            </div>

                            <div class="subscription-gifts__content">
                                <strong class="subscription-gifts__name">
                                    {{ item.name }}
                                </strong>

                                <div class="subscription-gifts__meta">
                                    <span class="subscription-gifts__kind">
                                        {% if kind %}
                                            {{ ('cosmetic_kind.' ~ kind)|trans({}, 'enums') }}
                                        {% else %}
                                            {{ ('shop_product_type.' ~ item.type)|trans({}, 'enums') }}
                                        {% endif %}
                                    </span>

                                    <span class="subscription-gifts__status subscription-gifts__status--{{ tone }}">
                                        {% if item.delivery %}
                                            {{ item.delivery.status.value == 'paid' ? 'site.shop.subscription_gifts.awaiting_shipment'|trans : item.delivery.status.translate() }}
                                        {% else %}
                                            {{ ('site.shop.subscription_gifts.states.' ~ item.status)|trans }}
                                        {% endif %}
                                    </span>
                                </div>

                                {% if item.delivery and item.delivery.variant %}
                                    <span class="subscription-gifts__variant">
                                        {{ item.delivery.variant }}
                                    </span>
                                {% endif %}

                                {% if item.delivery and item.delivery.tracking %}
                                    <span class="subscription-gifts__tracking">
                                        {{ 'site.shop.orders.tracking'|trans({code: item.delivery.tracking}) }}
                                    </span>
                                {% endif %}
                            </div>

                            {% if item.status == 'granted' %}
                                <a class="subscription-gifts__action" href="{{ path(item.type == 'badge' ? 'site_profile_me' : 'site_shop_inventory') }}">
                                    {{ 'site.shop.subscription_gifts.view_collection'|trans }}
                                </a>
                            {% elseif item.type == 'physical' and item.status == 'pending' %}
                                <a class="subscription-gifts__action" href="#gift-shipping-{{ gift.id }}">
                                    {{ 'site.shop.subscription_gifts.shipping_title'|trans }}
                                </a>
                            {% elseif item.delivery %}
                                <a class="subscription-gifts__action" href="{{ path('site_shop_orders') }}">
                                    {{ 'site.shop.nav.orders'|trans }}
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>

                {% if gift.pending is not empty %}
                    <form id="gift-shipping-{{ gift.id }}" class="subscription-gifts__form" method="post" action="{{ path('site_subscription_gift_claim', {id: gift.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('subscription-gifts') }}">

                        <h3 class="subscription-gifts__form-title">
                            {{ 'site.shop.subscription_gifts.shipping_title'|trans }}
                        </h3>

                        <p class="subscription-gifts__help">
                            {{ 'site.shop.subscription_gifts.shipping_help'|trans }}
                        </p>

                        <div class="subscription-gifts__fields">
                            {% set limits = {
                                name: 120,
                                line1: 180,
                                line2: 180,
                                postal_code: 20,
                                city: 100,
                                phone: 40
                            } %}

                            {% set autocomplete = {
                                name: 'shipping name',
                                line1: 'shipping address-line1',
                                line2: 'shipping address-line2',
                                postal_code: 'shipping postal-code',
                                city: 'shipping address-level2',
                                phone: 'shipping tel'
                            } %}

                            {% for field in ['name','line1','line2','postal_code','city','phone'] %}
                                <label class="field">
                                    {{ ('site.shop.subscription_gifts.fields.' ~ field)|trans }}

                                    <input class="field__input" type="{{ field == 'phone' ? 'tel' : 'text' }}" name="address[{{ field }}]" maxlength="{{ limits[field] }}" autocomplete="{{ autocomplete[field] }}" value="{{ form.address[field] ?? '' }}" {% if field not in ['line2', 'phone'] %}required{% endif %}>
                                </label>
                            {% endfor %}

                            <label class="field">
                                {{ 'site.shop.subscription_gifts.fields.country'|trans }}

                                {% set selectedCountry = form.address.country ?? app_user().country ?? '' %}
                                <select class="field__input" name="address[country]" autocomplete="shipping country" required>
                                    <option value="">{{ 'site.shop.subscription_gifts.choose_country'|trans }}</option>
                                    {% for country in countries %}
                                        <option value="{{ country.code }}"{{ selectedCountry == country.code ? ' selected' }}>{{ country|localize('name') }}</option>
                                    {% endfor %}
                                </select>
                            </label>

                            {% for item in gift.pending %}
                                {% if item.sizes is not empty %}
                                    <label class="field">
                                        {{ 'site.shop.subscription_gifts.variant'|trans({name: item.name}) }}

                                        <select class="field__input" name="variants[{{ item.product }}]" required>
                                            <option value="">
                                                {{ 'site.shop.subscription_gifts.choose_variant'|trans }}
                                            </option>

                                            {% for size in item.sizes %}
                                                <option value="{{ size }}"{{ (form.variants[item.product] ?? '') == size ? ' selected' }}>
                                                    {{ size }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </label>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <label class="shop-checkout__terms">
                            <input type="checkbox" name="terms" value="1" required{{ (form.terms ?? '') == '1' ? ' checked' }}>

                            <span>
                                {{ 'site.shop.terms_physical'|trans({url: '/cgv'})|raw }}
                            </span>
                        </label>

                        <button type="submit" class="btn btn--primary subscription-gifts__submit">
                            {{ 'site.shop.subscription_gifts.claim'|trans }}
                        </button>
                    </form>
                {% endif %}
            </section>
        {% else %}
            <section class="shop-panel">
                <p class="shop-empty">
                    {{ 'site.shop.subscription_gifts.empty'|trans }}
                </p>

                <a class="shop-link" href="{{ path('site_shop_index', {tab: 'subscription'}) }}">
                    {{ 'site.shop.inventory.see_plans'|trans }}
                </a>
            </section>
        {% endfor %}
    </div>
{% endblock %}