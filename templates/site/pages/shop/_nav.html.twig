<nav class="shop-subnav" aria-label="{{ 'site.shop.title'|trans }}">
    {% for item in ['index','inventory','subscription_gifts','orders','redeem'] %}
        {% set href = item == 'subscription_gifts' ? path('site_subscription_gift_index') : path('site_shop_' ~ item) %}

        <a href="{{ href }}" class="shop-subnav__link{{ page == item ? ' shop-subnav__link--active' }}" {% if page == item %}aria-current="page"{% endif %}>
            {{ ('site.shop.nav.' ~ item)|trans }}
        </a>
    {% endfor %}
</nav>