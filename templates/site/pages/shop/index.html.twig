{% extends '@site/layouts/default.html.twig' %}

{% import '@site/components/macros/shop.html.twig' as shop %}
{% import '@site/components/macros/shop_catalog.html.twig' as catalog %}

{% set active = 'shop' %}
{% set user = app_user() %}
{% set member = user and not user.guest %}
{% set purse = wallet() %}
{% set initials = member ? user.initials : 'BG' %}
{% set total = products|length + plans|length %}

{% block title %}{{ 'site.shop.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="shop shop-store" data-component="ShopCatalog" data-count-label="{{ 'site.shop.catalog.results'|trans({ count: '__COUNT__' }) }}">
        <header class="shop-store__hero">
            <div class="shop-store__intro">
                <span class="shop-store__eyebrow">{{ 'site.shop.catalog.kicker'|trans }}</span>
                <h1 class="shop-store__title">{{ 'site.shop.title'|trans }}</h1>
                <p class="shop-store__subtitle">{{ 'site.shop.catalog.subtitle'|trans }}</p>
                <p class="shop-store__earn">{{ shop.icon('coins') }}{{ 'site.shop.catalog.earn'|trans(rewards) }}</p>
            </div>
            {% if purse %}
                <div class="shop-store__wallet" aria-label="{{ 'site.shop.catalog.balance'|trans }}">
                    <div class="shop-store__balance shop-store__balance--coins">
                        <span class="shop-store__balance-icon">{{ shop.icon('coins') }}</span>
                        <div><strong class="shop-store__balance-value">{{ purse.coins|number_format(0, ',', ' ') }}</strong><span class="shop-store__balance-label">{{ 'site.shop.purse.coins'|trans }}</span></div>
                    </div>
                    <div class="shop-store__balance shop-store__balance--lives">
                        <span class="shop-store__balance-icon">{{ shop.icon('lives') }}</span>
                        <div><strong class="shop-store__balance-value">{{ purse.unlimited ? '∞' : purse.left ~ '/' ~ purse.max }}{% if purse.bonus > 0 %}<small> +{{ purse.bonus }}</small>{% endif %}</strong><span class="shop-store__balance-label">{{ purse.unlimited ? 'site.shop.purse.unlimited'|trans : 'site.shop.purse.lives'|trans({ time: purse.resetAt|date('H:i') }) }}</span></div>
                    </div>
                    {% if subscription %}
                        <a class="shop-store__subscription" href="{{ path('site_shop_inventory') }}">{{ shop.icon('subscription') }}<span><strong>{{ subscription.product ? subscription.product|localize('name') : subscription.name }}</strong><small>{{ 'site.shop.purse.until'|trans({ date: subscription.endsAt|date('d/m/Y') }) }}</small></span><span aria-hidden="true">↗</span></a>
                    {% endif %}
                </div>
            {% endif %}
        </header>

        {% if member %}{% include '@site/pages/shop/_nav.html.twig' with { page: 'index' } %}{% endif %}
        {{ shop.flashes() }}
        {% if not card and is_granted('ROLE_ADMIN') %}<p class="shop-flash shop-flash--info">{{ 'site.shop.card_admin'|trans }}</p>{% endif %}

        <div class="shop-store__toolbar">
            <nav class="shop-store__categories" aria-label="{{ 'site.shop.categories'|trans }}">
                {% for item in tabs %}
                    <a class="shop-store__category{{ tab == item ? ' shop-store__category--active' }}" href="{{ path('site_shop_index', item == 'all' ? {} : { tab: item }) }}"{% if tab == item %} aria-current="page"{% endif %}>{{ shop.icon(item) }}<span>{{ ('site.shop.tabs.' ~ item)|trans }}</span><small>{{ counts[item] ?? 0 }}</small></a>
                {% endfor %}
            </nav>
            <label class="shop-store__search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
                <span class="sr-only">{{ 'site.shop.catalog.search'|trans }}</span>
                <input type="search" data-shop-search placeholder="{{ 'site.shop.catalog.search'|trans }}" autocomplete="off">
            </label>
        </div>
        <p class="shop-store__results" data-shop-results role="status" aria-live="polite">{{ 'site.shop.catalog.results'|trans({ count: total }) }}</p>

        {% if plans is not empty %}
            <section class="shop-store__section" data-shop-group aria-labelledby="shop-subscriptions">
                <header class="shop-store__section-head"><div><h2 id="shop-subscriptions">{{ 'site.shop.tabs.subscription'|trans }}</h2><p>{{ 'site.shop.catalog.descriptions.subscription'|trans }}</p></div><span class="shop-store__section-count">{{ plans|length }}</span></header>
                <div class="shop-store__plans{{ plans|length == 1 ? ' shop-store__plans--single' }}">{% for product in plans %}{{ catalog.plan(product, owned[product.id] ?? false, card, member, initials, plans|length == 1) }}{% endfor %}</div>
            </section>
        {% endif %}

        {% for category in ['coins', 'lives', 'cosmetic', 'badge', 'physical', 'gift'] %}
            {% set items = products|filter(product => product.type.value == category) %}
            {% if items is not empty %}
                <section class="shop-store__section" data-shop-group aria-labelledby="shop-category-{{ category }}">
                    <header class="shop-store__section-head"><div><h2 id="shop-category-{{ category }}">{{ ('site.shop.tabs.' ~ category)|trans }}</h2><p>{{ ('site.shop.catalog.descriptions.' ~ category)|trans }}</p></div><span class="shop-store__section-count">{{ items|length }}</span></header>
                    <div class="shop-store__grid{{ items|length == 1 ? ' shop-store__grid--single' }}">{% for product in items %}{{ catalog.product(product, owned[product.id] ?? false, card, member, initials) }}{% endfor %}</div>
                </section>
            {% endif %}
        {% endfor %}

        <div class="shop-store__empty" data-shop-empty{{ total > 0 ? ' hidden' }}>
            {{ shop.icon('all') }}
            <h2>{{ 'site.shop.catalog.empty_title'|trans }}</h2>
            <p>{{ 'site.shop.catalog.empty_help'|trans }}</p>
            <button class="btn btn--ghost" type="button" data-shop-clear hidden>{{ 'site.shop.catalog.clear_search'|trans }}</button>
        </div>
    </div>
{% endblock %}
