{% import '@site/components/macros/user.html.twig' as ui %}
{% set user = app_user() %}

<header class="site-header">
    <button type="button" class="site-header__menu" data-sidebar-open aria-controls="site-sidebar" aria-expanded="false" aria-label="{{ 'site.nav.open'|trans }}">
        <svg class="site-header__menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a href="{{ path('site_home_index') }}" class="site-header__logo" aria-label="{{ 'site.header.home'|trans }}">
        <span class="site-header__mark">
            BG
        </span>
        <span class="site-header__name">
            BATTLE<span class="site-header__accent">GAME</span>
        </span>
    </a>
    <form class="site-header__search" action="{{ path('site_search_index') }}" method="get" role="search"
          data-component="HeaderSearch"
          data-labels="{{ { games: 'site.search.games'|trans, players: 'site.search.players'|trans, empty: 'site.search.no_match'|trans, all: 'site.search.all'|trans }|json_encode }}">
        <svg class="site-header__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5"/></svg>
        <input type="search" class="site-header__search-input" name="q" maxlength="60" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-suggest" aria-autocomplete="list" aria-label="{{ 'site.header.search_label'|trans }}" placeholder="{{ 'site.header.search'|trans }}">
        <div id="search-suggest" class="search-suggest" role="listbox" hidden></div>
    </form>
    <form class="site-header__join" action="{{ path('site_room_join') }}" method="get">
        <input class="site-header__code" name="code" aria-label="{{ 'site.header.room_code'|trans }}" placeholder="{{ 'site.header.room_code'|trans }}">
        <button type="submit" class="btn btn--cyan-outline">
            {{ 'site.header.join'|trans }}
        </button>
    </form>
    <div class="site-header__actions">
        {% if user and not user.guest %}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_home') }}" class="site-header__admin" title="{{ 'site.header.admin'|trans }}">
                    <svg class="site-header__notify-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
                    <span class="site-header__admin-label">{{ 'site.header.admin'|trans }}</span>
                </a>
            {% endif %}
            {% set purse = wallet() %}
            {% if purse %}
                <a href="{{ path('site_shop_index') }}" class="site-header__wallet" title="{{ 'site.shop.title'|trans }}">
                    <span class="site-header__wallet-item site-header__wallet-item--coins">
                        <svg class="site-header__wallet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v10M9 9.5c0-1 1.3-1.5 3-1.5s3 .7 3 1.8c0 2.7-6 1.4-6 4.2 0 1.1 1.3 2 3 2s3-.6 3-1.6"/></svg>
                        {{ purse.coins|number_format(0, ',', ' ') }}
                    </span>
                    <span class="site-header__wallet-item site-header__wallet-item--lives">
                        <svg class="site-header__wallet-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
                        {{ purse.unlimited ? '∞' : purse.left + purse.bonus }}
                    </span>
                </a>
            {% endif %}
            {% set unread = notifications_unread() %}
            <div class="notify" data-component="NotificationBell"
                 data-url="{{ mercure('users/' ~ user.id, { subscribe: true }) }}"
                 data-list="{{ path('site_notification_index') }}"
                 data-read="{{ path('site_notification_read') }}"
                 data-token="{{ csrf_token('notifications') }}"
                 data-empty="{{ 'site.notifications.empty'|trans }}">
                <button type="button" class="site-header__notify" aria-expanded="false" aria-haspopup="true" aria-label="{{ 'site.header.notifications'|trans }}">
                    <svg class="site-header__notify-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4l2-2zM10 21h4"/></svg>
                    <span class="notify__badge"{{ unread == 0 ? ' hidden' }}>{{ min(99, unread) }}</span>
                </button>
                <div class="notify__panel" hidden>
                    <div class="notify__head">
                        <strong class="notify__title">{{ 'site.notifications.title'|trans }}</strong>
                        <a href="{{ path('site_friend_index') }}" class="notify__link">{{ 'site.notifications.friends'|trans }}</a>
                    </div>
                    <ul class="notify__list"></ul>
                </div>
            </div>
            <a href="{{ path('site_profile_me') }}" class="site-header__profile">
                {{ ui.avatar(user) }}
                <span class="site-header__profile-text">
                    <span class="site-header__profile-name">
                        {{ ui.name(user, null, user.firstName) }}
                    </span>
                    <span class="site-header__profile-meta">
                        {{ user.handle }}
                    </span>
                </span>
            </a>
        {% else %}
            {% if user %}
                <span class="site-header__guest">
                    {{ 'site.auth.guest_label'|trans }} ·
                    <strong class="site-header__guest-name">{{ user.username }}</strong>
                </span>
            {% endif %}
            <a href="{{ path('site_security_login') }}" class="btn btn--primary">
                {{ 'site.auth.login'|trans }}
            </a>
        {% endif %}
    </div>
</header>