{% macro money(cents) %}{{ (cents / 100)|number_format(2, ',', ' ') }} €{% endmacro %}
{% import _self as m %}
{% set credit = invoice.kind.value == 'credit' %}
{% set sign = credit ? -1 : 1 %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ invoice.kind.translate }} {{ invoice.number }}</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #E9EBF2; color: #12141F; font: 14px/1.5 Inter, Arial, sans-serif; }
        .bar { display: flex; gap: 10px; justify-content: center; padding: 16px; }
        .bar button, .bar a { padding: 10px 18px; border: 1px solid #C9CDE3; border-radius: 10px; background: #fff; color: #12141F; font: 600 14px Inter, Arial, sans-serif; text-decoration: none; cursor: pointer; }
        .bar button { border-color: #12141F; background: #12141F; color: #fff; }
        .sheet { width: min(210mm, 100% - 24px); margin: 0 auto 32px; padding: 18mm 16mm; background: #fff; box-shadow: 0 10px 40px rgba(18, 20, 31, 0.12); }
        .head { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 36px; }
        .brand { font: 700 24px 'Chakra Petch', Arial, sans-serif; letter-spacing: 0.04em; }
        .brand span { color: #C2189A; }
        .doc { text-align: right; }
        .doc h1 { margin: 0 0 4px; font-size: 22px; text-transform: uppercase; letter-spacing: 0.06em; }
        .muted { color: #5E6690; }
        .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px; }
        .party h2 { margin: 0 0 6px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #5E6690; }
        .party p { margin: 0; white-space: pre-line; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        th { padding: 10px 8px; border-bottom: 2px solid #12141F; font-size: 11px; letter-spacing: 0.08em; text-align: left; text-transform: uppercase; }
        td { padding: 12px 8px; border-bottom: 1px solid #E2E4EE; }
        .num { text-align: right; white-space: nowrap; }
        .totals { width: 280px; margin-left: auto; }
        .totals div { display: flex; justify-content: space-between; padding: 6px 0; }
        .totals .grand { margin-top: 6px; padding-top: 10px; border-top: 2px solid #12141F; font-size: 17px; font-weight: 700; }
        .notes { margin-top: 36px; font-size: 12px; color: #5E6690; }
        .notes p { margin: 4px 0; }
        .warning { margin: 0 auto 16px; width: min(210mm, 100% - 24px); padding: 12px 16px; border-radius: 10px; background: #FFF4D6; color: #7A5300; font-size: 13px; }
        @media print {
            body { background: #fff; }
            .bar, .warning { display: none; }
            .sheet { width: auto; margin: 0; padding: 0; box-shadow: none; }
            @page { size: A4; margin: 16mm; }
        }
        @media (max-width: 600px) {
            .sheet { padding: 20px 16px; }
            .head, .parties { display: block; }
            .doc { text-align: left; margin-top: 12px; }
            .party { margin-bottom: 16px; }
            .totals { width: 100%; }
        }
    </style>
</head>
<body>
    <div class="bar">
        <button type="button" onclick="window.print()">{{ 'site.invoice.print'|trans }}</button>
        <a href="{{ back }}">{{ 'site.invoice.back'|trans }}</a>
    </div>
    {% if invoice.seller.name is empty %}
        <p class="warning">{{ 'site.invoice.missing_seller'|trans }}</p>
    {% endif %}
    <main class="sheet">
        <header class="head">
            <div>
                <div class="brand">BATTLE<span>GAME</span></div>
                <p class="muted">{{ invoice.seller.name ?: '—' }}{% if invoice.seller.form %} · {{ invoice.seller.form }}{% endif %}</p>
            </div>
            <div class="doc">
                <h1>{{ invoice.kind.translate }}</h1>
                <div><strong>{{ invoice.number }}</strong></div>
                <div class="muted">{{ 'site.invoice.date'|trans({ date: invoice.issuedAt|date('d/m/Y') }) }}</div>
                {% if credit %}
                    <div class="muted">{{ 'site.invoice.credit_of'|trans({ number: invoice.reference }) }}</div>
                {% elseif invoice.order %}
                    <div class="muted">{{ 'site.invoice.order'|trans({ reference: invoice.order.reference }) }}</div>
                {% endif %}
            </div>
        </header>

        <section class="parties">
            <div class="party">
                <h2>{{ 'site.invoice.seller'|trans }}</h2>
                <p><strong>{{ invoice.seller.name ?: '—' }}</strong>
{{ invoice.seller.address }}
{% if invoice.seller.siret %}SIRET : {{ invoice.seller.siret }}
{% endif %}{% if invoice.seller.vat_number and not invoice.seller.exempt %}{{ 'site.invoice.vat_number'|trans }} : {{ invoice.seller.vat_number }}
{% endif %}{{ invoice.seller.email }}</p>
            </div>
            <div class="party">
                <h2>{{ 'site.invoice.buyer'|trans }}</h2>
                <p><strong>{{ invoice.buyer.name ?? '—' }}</strong>
{% if invoice.buyer.address is defined %}{{ invoice.buyer.address }}
{% endif %}{% if invoice.buyer.email is defined %}{{ invoice.buyer.email }}
{% endif %}{% if invoice.buyer.username is defined %}{{ 'site.invoice.account'|trans({ name: invoice.buyer.username }) }}{% endif %}</p>
            </div>
        </section>

        <table>
            <thead>
                <tr>
                    <th>{{ 'site.invoice.label'|trans }}</th>
                    <th class="num">{{ 'site.invoice.quantity'|trans }}</th>
                    <th class="num">{{ 'site.invoice.net'|trans }}</th>
                    <th class="num">{{ 'site.invoice.vat'|trans }}</th>
                    <th class="num">{{ 'site.invoice.total'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for line in invoice.lines %}
                    <tr>
                        <td>{{ line.label }}<br><span class="muted">{{ ('shop_product_type.' ~ line.type)|trans({}, 'enums') }}</span></td>
                        <td class="num">{{ line.quantity }}</td>
                        <td class="num">{{ m.money(sign * line.net) }}</td>
                        <td class="num">{{ m.money(sign * line.vat) }}</td>
                        <td class="num">{{ m.money(sign * line.total) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="totals">
            <div><span>{{ 'site.invoice.total_net'|trans }}</span><span>{{ m.money(sign * invoice.netCents) }}</span></div>
            <div><span>{{ invoice.seller.exempt ? 'site.invoice.vat_exempt_short'|trans : 'site.invoice.total_vat'|trans({ rate: invoice.vatRate|number_format(1, ',', ' ')|replace({ ',0': '' }) }) }}</span><span>{{ m.money(sign * invoice.vatCents) }}</span></div>
            <div class="grand"><span>{{ credit ? 'site.invoice.total_credit'|trans : 'site.invoice.total_paid'|trans }}</span><span>{{ m.money(sign * invoice.totalCents) }}</span></div>
        </div>

        <footer class="notes">
            {% if invoice.seller.exempt %}<p>{{ 'site.invoice.exempt_mention'|trans }}</p>{% endif %}
            <p>{{ credit ? 'site.invoice.credit_note'|trans : 'site.invoice.paid_note'|trans({ date: invoice.order and invoice.order.paidAt ? invoice.order.paidAt|date('d/m/Y') : invoice.issuedAt|date('d/m/Y') }) }}</p>
            <p>{{ 'site.invoice.legal'|trans }}</p>
        </footer>
    </main>
</body>
</html>
