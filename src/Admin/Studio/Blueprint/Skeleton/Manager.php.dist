<?php

namespace {{namespace}};

use App\Sdk\AbstractSdk;

class {{manager}} extends AbstractSdk
{
    private const START_DELAY = 2000;

    public function __construct()
    {
        $this->setLanguage('fr', 'translations/game.fr.yaml');
    }

    public function init(array $players, array $settings, int $startsAt): array
    {
        return {{server}}::begin({{server}}::setup($players, $settings), $startsAt + self::START_DELAY);
    }
}
