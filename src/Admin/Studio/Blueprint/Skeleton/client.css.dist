.nocode {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 20px 16px;
    background: radial-gradient(circle at 50% 30%, #161B3A, #05060C 72%);
    font-family: Inter, sans-serif;
    color: #E8EAF6;
}

.nocode__head {
    width: min(100%, 640px);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 700 13px 'Chakra Petch', sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2EE6D6;
}

.nocode__status {
    color: #E8EAF6;
    text-align: center;
}

.nocode__clock {
    font-variant-numeric: tabular-nums;
    color: #9AA0BF;
}

.nocode__screen {
    width: min(100%, 640px);
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.nocode__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.nocode__row > * {
    flex: 1 1 0;
    min-width: 0;
}

.nocode__text {
    margin: 0;
    text-align: center;
    font-size: 17px;
    line-height: 1.45;
}

.nocode__text--title {
    font: 700 26px 'Chakra Petch', sans-serif;
}

.nocode__text--big {
    font: 700 44px 'Chakra Petch', sans-serif;
    color: #2EE6D6;
}

.nocode__text--small {
    font-size: 13px;
}

.nocode__text--hint {
    font: 700 12px 'Chakra Petch', sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9AA0BF;
}

.nocode__button {
    min-height: 52px;
    padding: 0 22px;
    border: 1px solid #2EE6D6;
    border-radius: 14px;
    background: rgba(46, 230, 214, 0.12);
    font: 700 17px 'Chakra Petch', sans-serif;
    color: #2EE6D6;
    cursor: pointer;
    transition: transform 0.15s, background 0.15s, box-shadow 0.15s;
}

.nocode__button:not(:disabled):hover {
    background: rgba(46, 230, 214, 0.22);
    box-shadow: 0 0 22px rgba(46, 230, 214, 0.35);
}

.nocode__button:not(:disabled):active {
    transform: scale(0.97);
}

.nocode__button:disabled {
    opacity: 0.4;
    cursor: default;
}

.nocode__button--big {
    min-height: 96px;
    font-size: 30px;
}

.nocode__button--small {
    min-height: 40px;
    font-size: 14px;
}

.nocode__grid {
    width: min(100%, 420px, 52vh);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr));
    gap: 8px;
}

.nocode__cell {
    aspect-ratio: 1;
    min-width: 0;
    border: 1px solid #2E3456;
    border-radius: 12px;
    background: #10142A;
    font: 700 clamp(22px, 7vw, 44px) 'Chakra Petch', sans-serif;
    color: #E8EAF6;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
}

.nocode__cell:not(:disabled):hover {
    border-color: #2EE6D6;
    background: #161B3A;
}

.nocode__cell:disabled {
    cursor: default;
}

.nocode__cell[data-mark="1"] {
    color: #2EE6D6;
}

.nocode__cell[data-mark="2"] {
    color: #FF3DCB;
}

.nocode__cell[data-mark="3"] {
    color: #FFC94A;
}

.nocode__cell[data-mark="4"] {
    color: #4ADE80;
}

.nocode__form {
    display: flex;
    gap: 10px;
}

.nocode__input {
    flex: 1;
    min-width: 0;
    height: 52px;
    box-sizing: border-box;
    padding: 0 14px;
    border: 1px solid #2E3456;
    border-radius: 12px;
    background: #0B0D17;
    font: 700 20px 'JetBrains Mono', monospace;
    color: #E8EAF6;
    outline: none;
}

.nocode__input:focus {
    border-color: #2EE6D6;
}

.nocode__send {
    height: 52px;
    padding: 0 20px;
    border: 0;
    border-radius: 12px;
    background: #2EE6D6;
    font: 700 16px 'Chakra Petch', sans-serif;
    color: #04141A;
    cursor: pointer;
}

.nocode__input:disabled,
.nocode__send:disabled {
    opacity: 0.4;
}

.nocode__counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

.nocode__counter-label {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9AA0BF;
}

.nocode__counter-value {
    font: 700 40px 'Chakra Petch', sans-serif;
    color: #FFC94A;
}

.nocode__timer {
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: #1D2138;
}

.nocode__timer-fill {
    display: block;
    height: 100%;
    background: #2EE6D6;
}

.nocode__message {
    min-height: 24px;
    margin: 0;
    text-align: center;
    font: 700 18px 'Chakra Petch', sans-serif;
    color: #FFC94A;
}

.nocode__scores {
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
}

.nocode__score {
    display: flex;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid #262B45;
    border-radius: 999px;
    background: #121524;
    font-size: 13px;
}

.nocode__score--me {
    border-color: #2EE6D6;
}

.nocode__score--turn {
    box-shadow: 0 0 0 2px #FFC94A;
}

.nocode[data-phase="reveal"] .nocode__message,
.nocode[data-phase="finished"] .nocode__message {
    color: #4ADE80;
}

.nocode__choices {
    display: grid;
    grid-template-columns: repeat(var(--columns, 2), minmax(0, 1fr));
    gap: 10px;
}

.nocode__choice {
    min-height: 52px;
    padding: 8px 14px;
    border: 1px solid #2E3456;
    border-radius: 12px;
    background: #10142A;
    font: 600 16px Inter, sans-serif;
    color: #E8EAF6;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
}

.nocode__choice:not(:disabled):hover {
    border-color: #2EE6D6;
    background: #161B3A;
}

.nocode__choice:not(:disabled):active {
    transform: scale(0.98);
}

.nocode__choice:disabled {
    cursor: default;
    opacity: 0.45;
}

.nocode__image {
    display: block;
    max-width: 100%;
    max-height: 240px;
    margin: 0 auto;
    border-radius: 14px;
    object-fit: contain;
}

.nocode__image--small {
    max-height: 120px;
}

.nocode__image--big {
    max-height: 360px;
}

.nocode__icon {
    display: block;
    text-align: center;
    font-size: 40px;
    line-height: 1.1;
}

.nocode__icon--small {
    font-size: 24px;
}

.nocode__icon--big {
    font-size: 72px;
}

.nocode__divider {
    width: 100%;
    height: 1px;
    margin: 4px 0;
    border: 0;
    background: linear-gradient(90deg, transparent, #2E3456, transparent);
}

.nocode__box {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border: 1px solid #262B45;
    border-radius: 16px;
    background: rgba(18, 21, 36, 0.85);
}

.nocode__box-title {
    margin: 0;
    font: 700 14px 'Chakra Petch', sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9AA0BF;
}

.nocode__custom {
    min-width: 0;
}
